class Solution:
    def reverseKGroup(self, head, k):
        cur = head

        for _ in range(k):
            if not cur:
                return head
            cur = cur.next

        prev = None
        cur = head

        for _ in range(k):
            next_node = cur.next
            cur.next = prev
            prev = cur
            cur = next_node

        head.next = self.reverseKGroup(cur, k)

        return prev
